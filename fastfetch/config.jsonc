{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "windows",
    "color": {
      "1": "red",
      "2": "green",
      "3": "blue",
      "4": "yellow"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": " 󰅂 ",
    "color": {
      "keys": "magenta",
      "title": "cyan"
    }
  },

  "modules": [
    "break",

    {
      "type": "os",
      "key": "󰍹 OS"
    },

    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },

    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },

    "break",

    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "format": "{name} | {freq} | {cores} cores"
    },

    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "format": "{name} | {frequency}"
    },

    {
      "type": "memory",
      "key": "󰍛 Memory",
      "format": "{used} / {total}"
    },

    {
      "type": "disk",
      "key": "󰋊 Storage",
      "folders": [
        "C:"
      ]
    },

    "break",

    {
      "type": "display",
      "key": "󰹑 Display"
    },

    {
      "type": "terminal",
      "key": "󰆍 Terminal"
    },

    {
      "type": "shell",
      "key": "󰘚 Shell"
    },

    "break",

    {
      "type": "colors",
      "key": "󰏘 Palette",
      "symbol": "circle"
    }
  ]
}
